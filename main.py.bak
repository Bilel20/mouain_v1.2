    "nombre_enfants",
)


def set_dialog_button_action_types(button_box):
    for button in button_box.buttons():
        text = button.text().replace("&", "")
        if "إغلاق" in text or "اغلاق" in text:
            button.setProperty("actionType", "close")
        elif any(label in text for label in ("تراجع", "رجوع", "عودة")):
            button.setProperty("actionType", "back")
        elif "إلغاء" in text or "الغاء" in text:
            button.setProperty("actionType", "cancel")
        elif any(label in text for label in ("حفظ", "موافق", "نعم", "متابعة الاستيراد", "إضافة الحصص")):
            button.setProperty("actionType", "save")


class Database:
    def __init__(self, path=DB_PATH):
        self.path = str(path)
        self.init_db()

    def connect(self):
        # إعادة استعمال العبارات وتقليل انتظار القفل عند فتح أكثر من نافذة.
        con = sqlite3.connect(self.path, timeout=10, cached_statements=256)
        con.execute("PRAGMA foreign_keys=ON")
        con.execute("PRAGMA busy_timeout=10000")
        return con

    def init_db(self):
        with self.connect() as c:
            # WAL يحسن التوازي بين القراءة والكتابة دون تغيير بنية البيانات.
            c.execute("PRAGMA journal_mode=WAL")
            c.execute("PRAGMA synchronous=NORMAL")
            c.executescript("""
            CREATE TABLE IF NOT EXISTS ann_scolaire (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                nom_annee TEXT NOT NULL DEFAULT '2026-2027',
                nom_ecole TEXT DEFAULT '',
                nom_enseignant TEXT DEFAULT '',
                nom_inspecteur TEXT DEFAULT '',
                grade TEXT DEFAULT '',
                nom_assistant_pedagogique TEXT DEFAULT '',
                diplomes_scientifiques TEXT DEFAULT '',
                date_recrutement TEXT DEFAULT '',
                date_titularisation TEXT DEFAULT '',
                date_derniere_visite TEXT DEFAULT '',
                note_pedagogique TEXT DEFAULT '',
                resume_rapport_visite TEXT DEFAULT '',
                langue TEXT DEFAULT '',
                telephone TEXT DEFAULT '',
                email TEXT DEFAULT '',
                situation_familiale TEXT DEFAULT '',
                nombre_enfants INTEGER NOT NULL DEFAULT 0
            );
            CREATE TABLE IF NOT EXISTS day_data (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                date TEXT NOT NULL,
                ann_scolaire_id INTEGER NOT NULL,
                UNIQUE(date, ann_scolaire_id),
                FOREIGN KEY(ann_scolaire_id) REFERENCES ann_scolaire(id) ON DELETE CASCADE
            );
            CREATE TABLE IF NOT EXISTS hessa (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                classe TEXT DEFAULT '',
                majal TEXT DEFAULT '',
                heure TEXT DEFAULT '',
                time TEXT DEFAULT '',
                wehda_number INTEGER DEFAULT 1,
                hessa_number INTEGER DEFAULT 1,
                namat_taallom TEXT DEFAULT '',
                day_data_id INTEGER NOT NULL,
                FOREIGN KEY(day_data_id) REFERENCES day_data(id) ON DELETE CASCADE
            );
            CREATE TABLE IF NOT EXISTS nachat (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                time TEXT DEFAULT '',
                hessa_id INTEGER NOT NULL,
                FOREIGN KEY(hessa_id) REFERENCES hessa(id) ON DELETE CASCADE
            );
            CREATE TABLE IF NOT EXISTS nachat_detail (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                key_name TEXT NOT NULL,
                value_text TEXT DEFAULT '',
                nachat_id INTEGER NOT NULL,
                FOREIGN KEY(nachat_id) REFERENCES nachat(id) ON DELETE CASCADE
            );

            CREATE TABLE IF NOT EXISTS level (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL UNIQUE
            );

            CREATE TABLE IF NOT EXISTS majal (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL UNIQUE
            );

            CREATE TABLE IF NOT EXISTS competence_majal (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                competence TEXT NOT NULL,
                id_majal INTEGER NOT NULL,
                id_level INTEGER NOT NULL,
                FOREIGN KEY(id_majal) REFERENCES majal(id) ON DELETE CASCADE,
                FOREIGN KEY(id_level) REFERENCES level(id) ON DELETE CASCADE,
                UNIQUE(competence, id_majal, id_level)
            );

            CREATE TABLE IF NOT EXISTS competence_matiere (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                matiere TEXT NOT NULL,
                competence TEXT NOT NULL,
                id_competence_majal INTEGER NOT NULL,
                FOREIGN KEY(id_competence_majal) REFERENCES competence_majal(id) ON DELETE CASCADE,
                UNIQUE(matiere, competence, id_competence_majal)
            );

            CREATE TABLE IF NOT EXISTS moukawan_kifaya (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                competence TEXT NOT NULL,
                id_competence_matiere INTEGER NOT NULL,
                FOREIGN KEY(id_competence_matiere) REFERENCES competence_matiere(id) ON DELETE CASCADE,
                UNIQUE(competence, id_competence_matiere)
            );

            CREATE TABLE IF NOT EXISTS objectif_specifique (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                objectif_specifique TEXT NOT NULL,
                id_moukawa_kifaya INTEGER NOT NULL,
                description TEXT DEFAULT '',
                FOREIGN KEY(id_moukawa_kifaya) REFERENCES moukawan_kifaya(id) ON DELETE CASCADE,
                UNIQUE(objectif_specifique, id_moukawa_kifaya)
            );

            CREATE TABLE IF NOT EXISTS content (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                content TEXT NOT NULL,
                id_objectif_specifique INTEGER NOT NULL,
                description TEXT DEFAULT '',
                FOREIGN KEY(id_objectif_specifique) REFERENCES objectif_specifique(id) ON DELETE CASCADE,
                UNIQUE(content, id_objectif_specifique)
            );
            """)
            existing_columns = {
                row[1] for row in c.execute("PRAGMA table_info(ann_scolaire)")
            }
            new_columns = (
                ("nom_assistant_pedagogique", "TEXT DEFAULT ''"),
                ("diplomes_scientifiques", "TEXT DEFAULT ''"),
                ("date_recrutement", "TEXT DEFAULT ''"),
                ("date_titularisation", "TEXT DEFAULT ''"),
                ("date_derniere_visite", "TEXT DEFAULT ''"),
                ("note_pedagogique", "TEXT DEFAULT ''"),
                ("resume_rapport_visite", "TEXT DEFAULT ''"),
                ("langue", "TEXT DEFAULT ''"),
                ("telephone", "TEXT DEFAULT ''"),
                ("email", "TEXT DEFAULT ''"),
                ("situation_familiale", "TEXT DEFAULT ''"),
                ("nombre_enfants", "INTEGER NOT NULL DEFAULT 0"),
            )
            for column_name, column_definition in new_columns:
                if column_name not in existing_columns:
                    c.execute(
                        f"ALTER TABLE ann_scolaire ADD COLUMN "
                        f"{column_name} {column_definition}"
                    )

            c.executescript("""
            DELETE FROM level WHERE id NOT IN (
                SELECT MIN(id) FROM level GROUP BY name
            );
            DELETE FROM majal WHERE id NOT IN (
                SELECT MIN(id) FROM majal GROUP BY name
            );
            """)

            # فهارس تخدم الاستعلامات المتكررة في دفتر الدروس والبرامج الرسمية.
            c.executescript("""
            CREATE INDEX IF NOT EXISTS idx_day_data_year_date ON day_data(ann_scolaire_id, date);
            CREATE INDEX IF NOT EXISTS idx_hessa_day ON hessa(day_data_id);
            CREATE INDEX IF NOT EXISTS idx_nachat_hessa ON nachat(hessa_id);
            CREATE INDEX IF NOT EXISTS idx_nachat_title ON nachat(title);
            CREATE INDEX IF NOT EXISTS idx_nachat_detail_parent_key ON nachat_detail(nachat_id, key_name);
            CREATE INDEX IF NOT EXISTS idx_competence_majal_filter ON competence_majal(id_level, id_majal);
            CREATE INDEX IF NOT EXISTS idx_competence_matiere_parent ON competence_matiere(id_competence_majal);
            CREATE INDEX IF NOT EXISTS idx_moukawan_parent ON moukawan_kifaya(id_competence_matiere);
            CREATE INDEX IF NOT EXISTS idx_objectif_parent ON objectif_specifique(id_moukawa_kifaya);
            CREATE INDEX IF NOT EXISTS idx_content_parent ON content(id_objectif_specifique);
            """)

            row = c.execute("SELECT id FROM ann_scolaire ORDER BY id LIMIT 1").fetchone()
            if row:
                self.year_id = row[0]
            else:
                cur = c.execute(
                    "INSERT INTO ann_scolaire(nom_annee) VALUES(?)", ("2026-2027",)
                )
                self.year_id = cur.lastrowid

    def get_day_id(self, day):
        with self.connect() as c:
            row = c.execute(
                "SELECT id FROM day_data WHERE date=? AND ann_scolaire_id=?",
                (day, self.year_id)
            ).fetchone()
            if row:
                return row[0]
            cur = c.execute(
                "INSERT INTO day_data(date, ann_scolaire_id) VALUES(?,?)",
                (day, self.year_id)
            )
            return cur.lastrowid

    def lessons(self, day_id):
        with self.connect() as c:
            return c.execute("""SELECT id, hessa_number, classe, majal, heure, time,
                wehda_number, namat_taallom FROM hessa
                WHERE day_data_id=? ORDER BY id ASC""", (day_id,)).fetchall()

    def recorded_day_id(self, day):
        with self.connect() as c:
            row = c.execute("""
                SELECT d.id
                FROM day_data d
                WHERE d.date=? AND d.ann_scolaire_id=?
                    AND EXISTS (SELECT 1 FROM hessa h WHERE h.day_data_id=d.id)
            """, (day, self.year_id)).fetchone()
            return row[0] if row else None

    def lessons_for_weekday(self, weekday_num, target_day):
        sqlite_weekday = (weekday_num + 1) % 7
        with self.connect() as c:
            row = c.execute("""
                SELECT d.id
                FROM day_data d
                WHERE d.ann_scolaire_id=?
                    AND CAST(strftime('%w', d.date) AS INTEGER)=?
                    AND d.date<>?
                    AND EXISTS (SELECT 1 FROM hessa h WHERE h.day_data_id=d.id)
                ORDER BY ABS(julianday(d.date)-julianday(?)),
                    CASE WHEN d.date<=? THEN 0 ELSE 1 END,
                    d.date DESC
                LIMIT 1
            """, (self.year_id, sqlite_weekday, target_day, target_day, target_day)).fetchone()
            if not row:
                return []
            return c.execute("""
                SELECT classe, majal, heure, time
                FROM hessa
                WHERE day_data_id=?
                ORDER BY id
            """, (row[0],)).fetchall()

    def lesson_number_defaults(self, classe, majal):
        with self.connect() as c:
            rows = c.execute("""
                SELECT h.wehda_number, h.hessa_number, h.time
                FROM hessa h
                JOIN day_data d ON d.id=h.day_data_id
                WHERE d.ann_scolaire_id=? AND h.classe=? AND h.majal=?
                ORDER BY d.date DESC, h.id DESC
            """, (self.year_id, classe, majal)).fetchall()

        valid_rows = []
        for unit, lesson_number, duration in rows:
            try:
                unit = int(unit)
                lesson_number = int(lesson_number)
            except (TypeError, ValueError):
                continue
            if unit > 0 and lesson_number > 0:
                valid_rows.append((unit, lesson_number, duration))

        if not valid_rows:
            return 1, 1

        largest_unit = max(row[0] for row in valid_rows)
        rows_for_unit = [row for row in valid_rows if row[0] == largest_unit]
        largest_lesson = max(row[1] for row in rows_for_unit)
        last_lesson = next(row for row in rows_for_unit if row[1] == largest_lesson)
        is_arabic = "اللغة العربية" in majal.strip()
        has_120_minute_lesson = bool(re.search(r"\b120\b", str(last_lesson[2] or "")))
        next_lesson = largest_lesson + (2 if is_arabic and has_120_minute_lesson else 1)
        return largest_unit, next_lesson

    def lesson(self, lesson_id):
        with self.connect() as c:
            return c.execute("""SELECT id, classe, majal, heure, time, wehda_number,
                hessa_number, namat_taallom, day_data_id FROM hessa WHERE id=?""",
                (lesson_id,)).fetchone()

    def save_lessons(self, lessons, day_id):
        with self.connect() as c:
            c.executemany("""
                INSERT INTO hessa(classe,majal,heure,time,wehda_number,
                    hessa_number,namat_taallom,day_data_id)
                VALUES(?,?,?,?,?,?,?,?)
            """, [(*lesson, day_id) for lesson in lessons])

    def save_lesson(self, values, day_id, lesson_id=None):
        with self.connect() as c:
            if lesson_id:
                c.execute("""UPDATE hessa SET classe=?, majal=?, heure=?, time=?,
                    wehda_number=?, hessa_number=?, namat_taallom=? WHERE id=?""",
                    (*values, lesson_id))
            else:
                c.execute("""INSERT INTO hessa(classe,majal,heure,time,wehda_number,
                    hessa_number,namat_taallom,day_data_id) VALUES(?,?,?,?,?,?,?,?)""",
                    (*values, day_id))
                return c.execute("SELECT last_insert_rowid()").fetchone()[0]
        return lesson_id

    def delete_lesson(self, lesson_id):
        with self.connect() as c:
            c.execute("DELETE FROM hessa WHERE id=?", (lesson_id,))

    def activities(self, lesson_id):
        with self.connect() as c:
            return c.execute("SELECT id,title,time FROM nachat WHERE hessa_id=? ORDER BY id",
                             (lesson_id,)).fetchall()

    def save_activity(self, title, time, lesson_id, activity_id=None):
        with self.connect() as c:
            if activity_id:
                c.execute("UPDATE nachat SET title=?,time=? WHERE id=?",
                          (title, time, activity_id))
                return activity_id
            cur = c.execute("INSERT INTO nachat(title,time,hessa_id) VALUES(?,?,?)",
                            (title, time, lesson_id))
            return cur.lastrowid

    def delete_activity(self, activity_id):
        with self.connect() as c:
            c.execute("DELETE FROM nachat WHERE id=?", (activity_id,))

    def details(self, activity_id):
        with self.connect() as c:
            return c.execute("""SELECT id,key_name,value_text FROM nachat_detail
                WHERE nachat_id=? ORDER BY id""", (activity_id,)).fetchall()

    def save_detail(self, key, value, activity_id, detail_id=None):
        with self.connect() as c:
            if detail_id:
                c.execute("UPDATE nachat_detail SET key_name=?,value_text=? WHERE id=?",
                          (key, value, detail_id))
                return detail_id
            cur = c.execute("""INSERT INTO nachat_detail(key_name,value_text,nachat_id)
                VALUES(?,?,?)""", (key, value, activity_id))
            return cur.lastrowid

    def delete_detail(self, detail_id):
        with self.connect() as c:
            c.execute("DELETE FROM nachat_detail WHERE id=?", (detail_id,))

    def school_info(self):
        with self.connect() as c:
            columns = ", ".join(SCHOOL_INFO_COLUMNS)
            return c.execute(
                f"SELECT {columns} FROM ann_scolaire WHERE id=?",
                (self.year_id,)
            ).fetchone()

    def update_school_info(self, values):
        if len(values) != len(SCHOOL_INFO_COLUMNS):
            raise ValueError(
                f"Expected {len(SCHOOL_INFO_COLUMNS)} school-info values, "
                f"received {len(values)}."
            )
        assignments = ", ".join(
            f"{column}=?" for column in SCHOOL_INFO_COLUMNS
        )
        with self.connect() as c:
            c.execute(
                f"UPDATE ann_scolaire SET {assignments} WHERE id=?",
                (*values, self.year_id)
            )

    def get_latest_date(self):
        with self.connect() as c:
            row = c.execute(
                "SELECT date FROM day_data WHERE ann_scolaire_id=? ORDER BY date DESC LIMIT 1",
                (self.year_id,)
            ).fetchone()
            return row[0] if row else None
        
    def cleanup_empty_days(self):
        with self.connect() as c:
            c.execute("""
                DELETE FROM day_data 
                WHERE ann_scolaire_id=? 
                AND id NOT IN (SELECT DISTINCT day_data_id FROM hessa)
            """, (self.year_id,))

    def predict_next_detail_key(self, activity_title, namat_taallom, current_count):
        try:
            with self.connect() as c:
                cursor = c.execute("""
                    SELECT n.id, d.key_name
                    FROM nachat_detail d
                    JOIN nachat n ON d.nachat_id = n.id
                    JOIN hessa h ON n.hessa_id = h.id
                    WHERE n.title = ? AND h.namat_taallom = ?
                    ORDER BY n.id, d.id
                """, (activity_title, namat_taallom))
                rows = cursor.fetchall()
                
                sequences = {}
                for nachat_id, key_name in rows:
                    if nachat_id not in sequences:
                        sequences[nachat_id] = []
                    sequences[nachat_id].append(key_name)
                
                candidates = []
                for seq in sequences.values():
                    if len(seq) > current_count:
                        candidates.append(seq[current_count])
                
                if candidates:
                    from collections import Counter
                    most_common = Counter(candidates).most_common(1)
                    if most_common:
                        return most_common[0][0]
        except Exception as e:
            print(f"Prediction error: {e}")
        return ""


class SchoolDataFormatter:
    def __init__(self, db_name=DB_PATH):
        self.db_name = str(db_name)

    def get_connection(self):
        conn = sqlite3.connect(self.db_name)
        conn.row_factory = sqlite3.Row
        return conn

    def normalize_date(self, date_str: str) -> str:
        date_str = date_str.strip()
        formats_to_try = ["%Y-%m-%d", "%d-%m-%Y", "%Y/%m/%d", "%d/%m/%Y"]
        for fmt in formats_to_try:
            try:
                dt = datetime.strptime(date_str, fmt)
                return dt.strftime("%Y-%m-%d")
            except ValueError:
                continue
        return date_str


class YearImportDialog(QDialog):
    def __init__(self, db, default_year_name="", parent=None):
        super().__init__(parent)
        self.setWindowTitle("تحديد السنة الدراسية للاستيراد")
        self.setMinimumWidth(380)
        self.db = db
        
        layout = QVBoxLayout(self)
        form = QFormLayout()
        
        self.combo_years = QComboBox()
        self.combo_years.setEditable(True)
        self.load_existing_years()
        if default_year_name:
            self.combo_years.setCurrentText(default_year_name)
            
        form.addRow("السنة الدراسية المستهدفة:", self.combo_years)
        layout.addLayout(form)
        
        buttons = QDialogButtonBox()
        buttons.addButton("متابعة الاستيراد", QDialogButtonBox.AcceptRole)
        buttons.addButton("إلغاء", QDialogButtonBox.RejectRole)
        set_dialog_button_action_types(buttons)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

    def load_existing_years(self):
        try:
            with self.db.connect() as con:
                cursor = con.cursor()
                cursor.execute("SELECT id, nom_annee FROM ann_scolaire")
                rows = cursor.fetchall()
                for row in rows:
                    self.combo_years.addItem(row[1], row[0])
        except Exception as e:
            print(f"Error loading years: {e}")

    def get_selected_year_name(self):
        return self.combo_years.currentText().strip()


class SchoolYearSelectionDialog(QDialog):
    def __init__(self, db, parent=None):
        super().__init__(parent)
        self.setObjectName("schoolYearExportDialog")
        self.setWindowTitle("اختيار السنة الدراسية للتصدير")
        self.setMinimumWidth(350)
        self.db = db
        
        layout = QVBoxLayout(self)
        form = QFormLayout()
        
        self.combo_years = QComboBox()
        self.load_years()
        
        form.addRow("السنة الدراسية:", self.combo_years)
        layout.addLayout(form)

        buttons = QDialogButtonBox()
        export_button = buttons.addButton("تصدير", QDialogButtonBox.AcceptRole)
        export_button.setProperty("actionType", "export")
        cancel_button = buttons.addButton("إلغاء", QDialogButtonBox.RejectRole)
        cancel_button.setProperty("actionType", "cancel")
        set_dialog_button_action_types(buttons)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

    def load_years(self):
        try:
            with self.db.connect() as con:
                cursor = con.cursor()
                cursor.execute("SELECT id, nom_annee FROM ann_scolaire")
                rows = cursor.fetchall()
                for row in rows:
                    self.combo_years.addItem(row[1], row[0])
        except Exception as e:
            print(f"Error loading years: {e}")

    def get_selected_year_info(self):
        year_id = self.combo_years.currentData()
        year_name = self.combo_years.currentText()
        return year_id, year_name


class CompletionWorkerSignals(QObject):
    finished = Signal(object)


class CompletionWorker(QRunnable):
    _smart_models = {}
    _smart_models_lock = threading.Lock()

    def __init__(self, request_id, db_path, key_name, activity_title, text,
                 position, cached_values, allow_completion):
        super().__init__()
        self.signals = CompletionWorkerSignals()
        self.request_id = request_id
        self.db_path = db_path
        self.key_name = key_name
        self.activity_title = activity_title
        self.text = text
        self.position = position
        self.cached_values = cached_values
        self.allow_completion = allow_completion

    def run(self):
        values = self.cached_values
        error = None
        try:
            if values is None:
                values = self._get_values()
            suffix = self._completion_suffix(values) if self.allow_completion else ""
            suggested_text = (
                self.text[:self.position] + suffix + self.text[self.position:]
            )
            suggestions, suggestion_error = self._smart_suggestions(
                suggested_text.strip(), values
            )
            error = suggestion_error
        except Exception as exc:
            suffix = ""
            suggestions = []
            error = f"Autocomplete failed: {exc}"
        self.signals.finished.emit((
            self.request_id, self.text, self.position, self.key_name,
            self.activity_title, suffix, suggestions, values, error
        ))

    def _get_values(self):
        with sqlite3.connect(self.db_path, timeout=10, cached_statements=256) as con:
            con.execute("PRAGMA busy_timeout=10000")
            rows = con.execute(
                """SELECT d.value_text
                   FROM nachat_detail d
                   JOIN nachat n ON n.id = d.nachat_id
                   WHERE d.key_name = ? AND n.title = ?
                     AND COALESCE(d.value_text, '') <> ''""",
                (self.key_name, self.activity_title),
            ).fetchall()
            if not rows:
                rows = con.execute(
                    """SELECT value_text FROM nachat_detail
                       WHERE key_name = ? AND COALESCE(value_text, '') <> ''""",
                    (self.key_name,),
                ).fetchall()
        return list(dict.fromkeys(
            str(row[0]).strip() for row in rows
            if row[0] is not None and str(row[0]).strip()
        ))

    def _completion_suffix(self, values):
        before_cursor = self.text[:self.position]
        if not before_cursor or not values:
            return ""

        from collections import Counter

        if before_cursor[-1].isspace():
            words = before_cursor.strip().split()
            if not words:
                return ""
            last_word = words[-1]
            next_word_counts = Counter()
            for value in values:
                words = [w.strip(".,،؛:!?؟()[]{}\"'«»") for w in value.split()]
                for index in range(len(words) - 1):
                    if words[index] == last_word and words[index + 1]:
                        next_word_counts[words[index + 1]] += 1
            candidates = next_word_counts.most_common(1)
            return candidates[0][0] + " " if candidates else ""

        word_match = re.search(r"[^\s]+$", before_cursor)
        if not word_match:
            return ""
        typed_word = word_match.group(0)
        if len(typed_word) < 2:
            return ""

        word_counts = Counter()
        for value in values:
            for word in value.split():
                clean_word = word.strip(".,،؛:!?؟()[]{}\"'«»")
                if clean_word:
                    word_counts[clean_word] += 1
        matches = [
            word for word in word_counts
            if word.startswith(typed_word) and word != typed_word
        ]
        if not matches:
            return ""
        matches.sort(key=lambda word: (-word_counts[word], len(word), word))
        return matches[0][len(typed_word):]

    def _smart_suggestions(self, query, values, limit=6):
        if len(query) < 2 or not values:
            return [], None

        cache_key = (self.db_path, self.key_name, self.activity_title)
        fingerprint = tuple(values)
        with self._smart_models_lock:
            cached = self._smart_models.get(cache_key)
            if cached is None or cached[0] != fingerprint:
                try:
                    from sklearn.feature_extraction.text import TfidfVectorizer
                    vectorizer = TfidfVectorizer(
                        analyzer="char_wb", ngram_range=(2, 5),
                        lowercase=False, sublinear_tf=True
                    )
                    matrix = vectorizer.fit_transform(values)
                    cached = (fingerprint, vectorizer, matrix)
                    self._smart_models[cache_key] = cached
                except (ImportError, ValueError):
                    return self._fallback_suggestions(query, values, limit), None

        try:
            from sklearn.metrics.pairwise import cosine_similarity
            vectorizer, matrix = cached[1], cached[2]
            scores = cosine_similarity(vectorizer.transform([query]), matrix).ravel()
            ranked = sorted(enumerate(scores), key=lambda item: item[1], reverse=True)
            return ([(values[i], float(score)) for i, score in ranked
                     if score > 0 and values[i] != query][:limit], None)
        except Exception as exc:
            return self._fallback_suggestions(query, values, limit), (
                f"Smart autocomplete ranking failed: {exc}"
            )

    @staticmethod
    def _fallback_suggestions(query, values, limit):
        from difflib import SequenceMatcher
        ranked = sorted(
            ((value, SequenceMatcher(None, query, value).ratio()) for value in values),
            key=lambda item: item[1], reverse=True
        )
        return [(value, score) for value, score in ranked
                if score > 0.12 and value != query][:limit]


class AutoCompletionTextEdit(QTextEdit):
    """إكمال واقتراح ذكي دون تنفيذ عمليات قاعدة البيانات على خيط الواجهة."""
    suggestions_ready = Signal(object)

    def __init__(self, db, key_combo, activity_title, parent=None):
        super().__init__(parent)
        self.db = db
        self.key_combo = key_combo
        self.activity_title = activity_title
        self.is_completing = False
        self.skip_next_completion = False
        self._completion_cache = {}
        self._request_id = 0
        self._completion_timer = QTimer(self)
        self._completion_timer.setSingleShot(True)
        self._completion_timer.setInterval(120)
        self._completion_timer.timeout.connect(self._start_completion)
        self._worker_running = False
        self._pending_request = False
        self.setAcceptRichText(False)
        self.textChanged.connect(self.on_text_changed)

    def keyPressEvent(self, event):
        cursor = self.textCursor()
        if event.key() in (Qt.Key_Backspace, Qt.Key_Delete):
            self.skip_next_completion = True
            if cursor.hasSelection():
                cursor.clearSelection()
                self.setTextCursor(cursor)
            super().keyPressEvent(event)
            return
        if event.key() in (Qt.Key_Tab, Qt.Key_Right) and cursor.hasSelection():
            cursor.clearSelection()
            cursor.movePosition(QTextCursor.End)
            self.setTextCursor(cursor)
            event.accept()
            return
        if event.key() in (Qt.Key_Left, Qt.Key_Up, Qt.Key_Down, Qt.Key_Home, Qt.Key_End):
            self.skip_next_completion = True
            super().keyPressEvent(event)
            return
        self.skip_next_completion = False
        super().keyPressEvent(event)

    def on_text_changed(self):
        if self.is_completing or self.skip_next_completion:
            return
        self.schedule_completion()

    def schedule_completion(self, allow_completion=True):
        self._request_id += 1
        self._allow_completion = allow_completion
        self._completion_timer.start()

    def refresh_for_key_change(self, *_args):
        self.schedule_completion(allow_completion=False)

    def _start_completion(self):
        if self._worker_running:
            self._pending_request = True
            return
        text = self.toPlainText()
        position = self.textCursor().position()
        key_name = self.key_combo.currentText().strip()
        cache_key = (key_name, self.activity_title)
        self._worker_running = True
        worker = CompletionWorker(
            self._request_id, self.db.path, key_name, self.activity_title,
            text, position, self._completion_cache.get(cache_key),
            self._allow_completion,
        )
        worker.signals.finished.connect(self._apply_completion_result)
        QThreadPool.globalInstance().start(worker)

    def _apply_completion_result(self, result):
        self._worker_running = False
        (request_id, text, position, key_name, activity_title, suffix,
         suggestions, values, error) = result
        if values is not None:
            self._completion_cache[(key_name, activity_title)] = values
        if error:
            print(error)
        if (
            request_id != self._request_id
            or text != self.toPlainText()
            or position != self.textCursor().position()
            or key_name != self.key_combo.currentText().strip()
            or activity_title != self.activity_title
        ):
            self._start_pending_request()
            return
        if suffix:
            self.is_completing = True
            try:
                cursor = self.textCursor()
                cursor.insertText(suffix)
                cursor.setPosition(position)
                cursor.setPosition(position + len(suffix), QTextCursor.KeepAnchor)
                self.setTextCursor(cursor)
            finally:
                self.is_completing = False
        self.suggestions_ready.emit(suggestions)

        self._start_pending_request()

    def _start_pending_request(self):
        if self._pending_request:
            self._pending_request = False
            self._completion_timer.stop()
            self._start_completion()

class CustomCalendarWidget(QCalendarWidget):
    def __init__(self, db, parent=None):
        super().__init__(parent)
        self.db = db
        self.refresh_recorded_dates()

    def refresh_recorded_dates(self):
        try:
            self.setDateTextFormat(QDate(), QTextCharFormat())
            with self.db.connect() as con:
                cursor = con.cursor()
                cursor.execute("""
                    SELECT DISTINCT d.date 
                    FROM day_data d
                    JOIN hessa h ON h.day_data_id = d.id
                    WHERE d.ann_scolaire_id = ?
                """, (self.year_id if hasattr(self, 'year_id') else self.db.year_id,))
                rows = cursor.fetchall()
                
                fmt = QTextCharFormat()
                fmt.setBackground(QColor("#d4edda"))
                fmt.setForeground(QColor("#155724"))
                
                for row in rows:
                    if row[0]:
                        qd = QDate.fromString(row[0], "yyyy-MM-dd")
                        if qd.isValid():
                            self.setDateTextFormat(qd, fmt)
        except Exception as e:
            print(f"Error loading recorded dates: {e}")


class LessonEntryDialog(QDialog):
    def __init__(self, title, df_history, weekday_num=None, default_values=None, parent=None):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.setMinimumWidth(520)
        self.df_history = df_history
        self.weekday_num = weekday_num
        self.is_updating = False
        
        layout = QVBoxLayout(self)
        form = QFormLayout()
        
        self.combo_classe = QComboBox()
        self.combo_classe.setEditable(True)
        classes = sorted(df_history['classe'].dropna().unique().tolist()) if df_history is not None and not df_history.empty else []
        self.combo_classe.addItems(classes)
        
        self.combo_majal = QComboBox()
        self.combo_majal.setEditable(True)
        
        self.combo_heure = QComboBox()
        self.combo_heure.setEditable(True)
        self.load_day_specific_heures()

        self.combo_time = QComboBox()
        self.combo_time.setEditable(True)
        self.combo_time.addItems(["30 دقيقة", "45 دقيقة", "60 دقيقة", "90 دقيقة", "120 دقيقة"])
        
        self.spin_wehda = QSpinBox()
        self.spin_wehda.setRange(1, 999)
        self.spin_wehda.setValue(1)
        
        self.spin_hessa = QSpinBox()
        self.spin_hessa.setRange(1, 999)
        self.spin_hessa.setValue(1)
        
        self.combo_namat = QComboBox()
        self.combo_namat.addItems(["منهجي", "إدماج", "تقييم", "دعم وعلاج"])
        self.combo_namat.setCurrentText("منهجي")
        
        form.addRow("القسم", self.combo_classe)
        form.addRow("المجال", self.combo_majal)
        form.addRow("التوقيت (مثال: 08:00-09:00)", self.combo_heure)
        form.addRow("مدة الحصة", self.combo_time)
        form.addRow("الوحدة", self.spin_wehda)
        form.addRow("الحصة", self.spin_hessa)
        form.addRow("نمط التعلم", self.combo_namat)
        
        layout.addLayout(form)
        
        buttons = QDialogButtonBox()
        buttons.addButton("حفظ", QDialogButtonBox.AcceptRole)
        buttons.addButton("إلغاء", QDialogButtonBox.RejectRole)
        set_dialog_button_action_types(buttons)
        buttons.accepted.connect(self.validate_and_accept)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)
        
        self.combo_classe.currentTextChanged.connect(self.on_classe_changed)
        self.combo_majal.currentTextChanged.connect(self.on_majal_changed)
        self.combo_heure.currentTextChanged.connect(self.on_heure_changed)
        
        if default_values:
            if default_values[0]:
                self.combo_classe.setCurrentText(str(default_values[0]))
            if default_values[1]:
                self.combo_majal.setCurrentText(str(default_values[1]))
            if default_values[2]:
                self.combo_heure.setCurrentText(str(default_values[2]))
            if default_values[3]:
                self.combo_time.setCurrentText(str(default_values[3]))
            if default_values[4]:
                self.spin_wehda.setValue(int(default_values[4] or 1))
            if default_values[5]:
                self.spin_hessa.setValue(int(default_values[5] or 1))
            if default_values[6]:
                self.combo_namat.setCurrentText(str(default_values[6]))
        elif classes:
            self.on_classe_changed(self.combo_classe.currentText())

    def load_day_specific_heures(self):
        if self.df_history is None or self.df_history.empty or self.weekday_num is None:
            return
        try:
            df = self.df_history.copy()
            df['date'] = pd.to_datetime(df['date'], errors='coerce')
            df['wd'] = df['date'].dt.dayofweek
            df_day = df[df['wd'] == self.weekday_num]
            if not df_day.empty and 'heure' in df_day.columns:
                heures = sorted(df_day['heure'].dropna().unique().tolist())
                self.combo_heure.clear()
                self.combo_heure.addItems(heures)
        except Exception as e:
            print(f"Error loading day specific heures: {e}")

    def on_classe_changed(self, classe_text):
        if self.is_updating or self.df_history is None or self.df_history.empty:
            return
        self.is_updating = True
        try:
            df = self.df_history.copy()
            df['date'] = pd.to_datetime(df['date'], errors='coerce')
            df['wd'] = df['date'].dt.dayofweek
            df_sub = df[(df['classe'] == classe_text) & (df['wd'] == self.weekday_num)]
            if df_sub.empty:
                df_sub = df[df['classe'] == classe_text]

            if not df_sub.empty:
                majals = sorted(df_sub['majal'].dropna().unique().tolist())
                self.combo_majal.clear()
                self.combo_majal.addItems(majals)

                heures = sorted(df_sub['heure'].dropna().unique().tolist())
                if heures:
                    self.combo_heure.clear()
                    self.combo_heure.addItems(heures)

                times = sorted(df_sub['time'].dropna().unique().tolist())
                if times:
                    self.combo_time.clear()
                    self.combo_time.addItems(times)
        except Exception as e:
            print(f"Error in on_classe_changed: {e}")
        finally:
            self.is_updating = False

    def on_majal_changed(self, majal_text):
        if self.is_updating or not majal_text.strip() or self.df_history is None or self.df_history.empty:
            return
        self.is_updating = True
        try:
            df = self.df_history.copy()
            classe_text = self.combo_classe.currentText().strip()
            df_sub = df[(df['majal'] == majal_text) & (df['classe'] == classe_text)]
            if df_sub.empty:
                df_sub = df[df['majal'] == majal_text]

            if not df_sub.empty:
                heures = sorted(df_sub['heure'].dropna().unique().tolist())
                if heures:
                    self.combo_heure.clear()
                    self.combo_heure.addItems(heures)
                    mode_heure = df_sub['heure'].mode()
                    if not mode_heure.empty:
                        self.combo_heure.setCurrentText(str(mode_heure.iloc[0]))
        except Exception as e:
            print(f"Error in on_majal_changed: {e}")
        finally:
            self.is_updating = False

    def on_heure_changed(self, heure_text):
        if self.is_updating or not heure_text.strip():
            return
        cleaned_text = heure_text.replace(" ", "").replace("ـ", "-")
        if "-" in cleaned_text:
            parts = cleaned_text.split("-")
            if len(parts) == 2:
                try:
                    t1 = datetime.strptime(parts[0].strip(), "%H:%M")
                    t2 = datetime.strptime(parts[1].strip(), "%H:%M")
                    if t2 >= t1:
                        diff_minutes = int((t2 - t1).total_seconds() / 60)
                        self.combo_time.setCurrentText(f"{diff_minutes} دقيقة")
                except ValueError:
                    pass

        if self.df_history is None or self.df_history.empty:
            return
        self.is_updating = True
        try:
            df = self.df_history.copy()
            classe_text = self.combo_classe.currentText().strip()
            df_sub = df[(df['heure'] == heure_text) & (df['classe'] == classe_text)]
            if df_sub.empty:
                df_sub = df[df['heure'] == heure_text]

            if not df_sub.empty:
                mode_majal = df_sub['majal'].mode()
                if not mode_majal.empty:
                    suggested_majal = str(mode_majal.iloc[0])
                    if self.combo_majal.findText(suggested_majal) >= 0:
                        self.combo_majal.setCurrentText(suggested_majal)
        except Exception as e:
            print(f"Error in on_heure_changed: {e}")
        finally:
            self.is_updating = False

    def validate_and_accept(self):
        heure_text = self.combo_heure.currentText().strip().replace(" ", "").replace("ـ", "-")
        if "-" in heure_text:
            parts = heure_text.split("-")
            if len(parts) == 2:
                try:
                    t1 = datetime.strptime(parts[0].strip(), "%H:%M").time()
                    t2 = datetime.strptime(parts[1].strip(), "%H:%M").time()
                    work_start = time(7, 0)
                    work_end = time(17, 0)
                    if not (work_start <= t1 <= work_end and work_start <= t2 <= work_end):
                        QMessageBox.warning(self, "توقيت غير مقبول", "أوقات العمل الرسمية بين 07:00 و 17:00.")
                        return
                    if t2 <= t1:
                        QMessageBox.warning(self, "خطأ في التوقيت", "وقت النهاية يجب أن يكون بعد وقت البداية.")
                        return
                except ValueError:
                    QMessageBox.warning(self, "توقيت غير صالح", "صيغة التوقيت غير مقبولة (مثال: 08:00-09:30).")
                    return
        self.accept()

    def values(self):
        return [
            self.combo_classe.currentText().strip(),
            self.combo_majal.currentText().strip(),
            self.combo_heure.currentText().strip(),
            self.combo_time.currentText().strip(),
            self.spin_wehda.value(),
            self.spin_hessa.value(),
            self.combo_namat.currentText().strip()
        ]


class BulkLessonEntryDialog(QDialog):
    def __init__(self, lessons, number_defaults, parent=None):
        super().__init__(parent)
        self.setWindowTitle("إضافة كل الحصص")
        self.setObjectName("bulkLessonEntryDialog")
        self.setMinimumSize(1280, 520)
        self.setLayoutDirection(Qt.RightToLeft)

        def lesson_sort_key(lesson):
            hour_text = str(lesson[2] or "").strip().replace("ـ", "-").replace(" ", "")
            start_text = hour_text.split("-", 1)[0]
            try:
                return 0, datetime.strptime(start_text, "%H:%M").time(), hour_text
            except ValueError:
                return 1, time.max, hour_text

        self.lessons = sorted(lessons, key=lesson_sort_key)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(24, 22, 24, 20)
        layout.setSpacing(16)
        info_label = QLabel("أدخل رقم الوحدة والحصة واختر نمط التعلم لكل حصة:")
        info_label.setObjectName("bulkLessonInfo")
        layout.addWidget(info_label)

        self.table = QTableWidget(len(self.lessons), 7)
        self.table.setHorizontalHeaderLabels([
            "القسم", "المجال", "ساعة التدريس", "التوقيت",
            "عدد الوحدة", "عدد الحصة", "نمط التعلم"
        ])
        self.table.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        self.table.verticalHeader().setVisible(False)
        self.table.setAlternatingRowColors(True)
        self.table.setShowGrid(False)
        self.table.setMinimumWidth(1230)
        self.table.verticalHeader().setDefaultSectionSize(58)
        self.table.setEditTriggers(
            QAbstractItemView.DoubleClicked
            | QAbstractItemView.EditKeyPressed
            | QAbstractItemView.SelectedClicked
        )

        self.row_inputs = []
        learning_modes = ["منهجي", "إدماج", "تقييم", "دعم وعلاج"]
        next_numbers = dict(number_defaults)
        for row, lesson in enumerate(self.lessons):
            for column, value in enumerate(lesson):
                item = QTableWidgetItem(str(value or ""))
                item.setTextAlignment(Qt.AlignCenter)
                if column >= 4:
                    item.setFlags(item.flags() | Qt.ItemIsEditable)
                else:
                    item.setFlags(item.flags() & ~Qt.ItemIsEditable)
                self.table.setItem(row, column, item)

            default_unit, default_lesson = number_defaults.get(
                (str(lesson[0] or "").strip(), str(lesson[1] or "").strip()),
                (1, row + 1)
            )
            key = (str(lesson[0] or "").strip(), str(lesson[1] or "").strip())
            default_unit, default_lesson = next_numbers.get(key, (default_unit, default_lesson))
            self.table.setItem(
                row, 4, QTableWidgetItem(str(default_unit))
            )
            self.table.setItem(
                row, 5, QTableWidgetItem(str(default_lesson))
            )
            mode_combo = QComboBox()
            mode_combo.addItems(learning_modes)
            mode_combo.setMinimumWidth(160)
            self.table.setCellWidget(row, 6, mode_combo)
            self.row_inputs.append(mode_combo)
            increment = 2 if (
                "اللغة العربية" in key[1]
                and re.search(r"\b120\b", str(lesson[3] or ""))
            ) else 1
            next_numbers[key] = (default_unit, default_lesson + increment)

        layout.addWidget(self.table)
        buttons = QDialogButtonBox()
        save_button = buttons.addButton("إضافة الحصص", QDialogButtonBox.AcceptRole)
        save_button.setObjectName("bulkSaveButton")
        cancel_button = buttons.addButton("إلغاء", QDialogButtonBox.RejectRole)
        cancel_button.setObjectName("bulkCancelButton")
        set_dialog_button_action_types(buttons)
        buttons.accepted.connect(self.validate_and_accept)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

    def validate_and_accept(self):
        for row in range(self.table.rowCount()):
            for column in (4, 5):
                item = self.table.item(row, column)
                try:
                    value = int(item.text().strip()) if item else 0
                except ValueError:
                    value = 0
                if not 1 <= value <= 999:
                    QMessageBox.warning(
                        self, "قيمة غير صالحة",
                        "يجب أن يكون عدد الوحدة وعدد الحصة رقماً بين 1 و999."
                    )
                    self.table.setCurrentCell(row, column)
                    return
        self.accept()

    def values(self):
        return [
            (
                str(lesson[0] or "").strip(),
                str(lesson[1] or "").strip(),
                str(lesson[2] or "").strip(),
                str(lesson[3] or "").strip(),
                int(self.table.item(row, 4).text().strip()),
                int(self.table.item(row, 5).text().strip()),
                mode_combo.currentText()
            )
            for row, (lesson, mode_combo)
            in enumerate(zip(self.lessons, self.row_inputs))
        ]


class EntryDialog(QDialog):
    def __init__(self, title, fields, values=None, parent=None):
        super().__init__(parent)
        self.setWindowTitle(title)
        if len(fields) > 10:
            self.setMinimumSize(1100, 650)
            self.resize(1250, 850)
        else:
            self.setMinimumWidth(480)
        self.widgets = []
        layout = QVBoxLayout(self)
        use_three_columns = len(fields) > 10
        form = QGridLayout() if use_three_columns else QFormLayout()
        if use_three_columns:
            for grid_column in range(3):
                form.setColumnStretch(grid_column, 1)
        row = 0
        column = 0
        
        for label, kind, default in fields:
            if kind in ("int", "nonnegative_int"):
                w = QSpinBox()
                w.setRange(0 if kind == "nonnegative_int" else 1, 999)
                initial_value = default if default is not None else (
                    0 if kind == "nonnegative_int" else 1
                )
                w.setValue(int(initial_value))
            elif kind in ["multiline", "plaintext"]:
                w = QTextEdit()
                w.setAcceptRichText(False)
                w.setPlainText(str(default or ""))
                w.setMinimumHeight(100)
                w.setAlignment(Qt.AlignCenter)
            elif kind == "date":
                w = QLineEdit(str(default or ""))
                w.setPlaceholderText("YYYY-MM-DD")
            else:
                w = QLineEdit(str(default or ""))

            if isinstance(w, QLineEdit):
                w.setAlignment(Qt.AlignCenter)
            elif isinstance(w, QSpinBox):
                w.lineEdit().setAlignment(Qt.AlignCenter)

            self.widgets.append(w)
            if use_three_columns:
                if kind == "plaintext" and column:
                    row += 1
                    column = 0

                label_widget = QLabel(label)
                label_widget.setAlignment(Qt.AlignCenter)
                cell = QWidget()
                cell_layout = QVBoxLayout(cell)
                cell_layout.setContentsMargins(0, 0, 0, 0)
                cell_layout.addWidget(label_widget)
                cell_layout.addWidget(w)
                if kind == "plaintext":
                    form.addWidget(cell, row, 0, 1, 3)
                    row += 1
                    column = 0
                else:
                    form.addWidget(cell, row, column)
                    column += 1
                    if column == 3:
                        row += 1
                        column = 0
            else:
                form.addRow(label, w)
            
        if values:
            for w, value in zip(self.widgets, values):
                if isinstance(w, QSpinBox):
                    w.setValue(int(
                        value if value is not None else
                        (0 if w.minimum() == 0 else 1)
                    ))
                elif isinstance(w, QTextEdit):
                    w.setPlainText(str(value or ""))
                else:
                    w.setText(str(value or ""))
                    
        layout.addLayout(form)
        
        buttons = QDialogButtonBox()
        buttons.addButton("حفظ", QDialogButtonBox.AcceptRole)
        buttons.addButton("إلغاء", QDialogButtonBox.RejectRole)
        set_dialog_button_action_types(buttons)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

    def values(self):
        result = []
        for w in self.widgets:
            if isinstance(w, QSpinBox):
                result.append(w.value())
            elif isinstance(w, QTextEdit):
                result.append(w.toPlainText().strip())
            else:
                result.append(w.text().strip())
        return result


class DaySelectionDialog(QDialog):
    def __init__(self, db, parent=None):
        super().__init__(parent)
        self.setWindowTitle("اختيار يوم للتصدير")
        self.setMinimumWidth(480)
